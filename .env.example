# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgres://app:app-pass@127.0.0.1:5432/playhub?sslmode=disable

# Magic link auth (dev: link is logged to backend stdout)
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/complete?token=
SESSION_COOKIE_NAME=lobby_session
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis pub/sub for queue match notifications (required for multi-instance; recommended locally)
REDIS_URL=redis://127.0.0.1:6379/0

# Game handoff (per-game play_url / api_base_url in DB are preferred; these are dev fallbacks)
GAME_CLIENT_BASE_URL=http://localhost:5174
GAME_API_BASE_URL=http://localhost:3001
# LOBBY_HANDOFF_DEBUG=true   # log game provision POSTs
# LOBBY_STALE_MATCH_MINUTES=5   # dev.sh default; omit for 30 in code

# Optional Bearer token for Lobby → game POST /api/v1/matches (when game sets REQUIRE_LOBBY_AUTH=true)
# LOBBY_GAME_SERVICE_TOKEN=

# Email (optional — without SMTP_HOST, magic links are logged to backend stdout)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_FROM=noreply@playhub.local
# SMTP_FROM_NAME=PlayHub

# JWT signing (seat tokens + session cookies). Without JWT_PRIVATE_KEY_PEM the
# backend persists a dev key to backend/.dev-jwt-key.pem so restarts keep the
# same JWKS (required for demo-game-rps LOBBY_JWKS_URL verification).
# Generate for production/k8s: cd backend && go run ./scripts/jwks.go
# JWKS_KID=lobby-dev
# JWT_PRIVATE_KEY_PEM=   # k8s secret key PRIV_PEM maps to this env var
# JWT_DEV_KEY_FILE=      # optional override for dev PEM path
