# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgres://app:app-pass@127.0.0.1:5432/playhub?sslmode=disable

# Magic link auth (dev: link is logged to backend stdout)
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/complete?token=
SESSION_COOKIE_NAME=lobby_session
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (optional — without SMTP_HOST, magic links are logged to backend stdout)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_FROM=noreply@playhub.local
# SMTP_FROM_NAME=PlayHub

# Optional JWT signing key (generate with: cd backend && go run ./scripts/jwks.go)
# JWKS_KID=lobby-dev
# JWT_PRIVATE_KEY_PEM=   # k8s secret key PRIV_PEM maps to this env var
