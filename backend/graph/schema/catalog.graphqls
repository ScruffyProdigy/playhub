input RegisterGameInput {
  slug: String!
  playUrl: String!
  apiBaseUrl: String!
  name: String
  description: String
}

type RegisterGamePayload {
  game: Game!
  webhookSecret: String!
  """Per-game credential for provision + player GraphQL (derived from game id)."""
  serviceToken: String!
}

type GameModeSeat {
  seatKey: String!
  team: String
  role: String
  """Lobby join bucket derived from seatTemplate (empty for fifo modes)."""
  queuePath: String
  sortOrder: Int!
}

"""One join bucket from seatTemplate (composition modes)."""
type GameModeQueuePath {
  queuePath: String!
  displayName: String!
  minPlayers: Int!
  maxPlayers: Int!
  playersToStart: Int!
}

type GameMode {
  id: ID!
  modeKey: String!
  displayName: String!
  minPlayers: Int!
  maxPlayers: Int!
  status: String!
  seats: [GameModeSeat!]!
  """Join options with human labels and per-cohort fire sizes."""
  queuePaths: [GameModeQueuePath!]!
  queues: [ModeQueue!]!
}

type ModeQueue {
  id: ID!
  name: String!
  playersToStart: Int!
  status: String!
  waitingCount: Int!
}

extend type Game {
  slug: String
  playUrl: String
  apiBaseUrl: String
  manifestSyncedAt: Time
  manifestHash: String
  gameVersion: String
  modes: [GameMode!]!
}

extend type Mutation {
  registerGame(input: RegisterGameInput!): RegisterGamePayload!
  refreshGameManifest(gameId: ID!): Game!
}
